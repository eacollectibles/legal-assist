        "image": "https://static.wixstatic.com/media/99571b_facd7ab6718046bc8572b74957bbf7e4~mv2.png",
        "email": "mailto:jeanfrancois@legalassist.london",
        "telephone": PHONE_TEL,
        "url": "https://www.legalassist.london/about/team#johnny-demers",
        "worksFor": { "@id": "https://www.legalassist.london/#organization" },
        "memberOf": {
          "@type": "Organization",
          "name": "Law Society of Ontario",
          "url": "https://lso.ca"
        },
        "knowsAbout": [
