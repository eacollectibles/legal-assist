            "credentialCategory": "license"
          }
        ]
      },
      {
        "@type": "Person",
        "@id": "https://www.legalassist.london/about/team#candice-fogarty",
        "name": "Candice Fogarty",
        "givenName": "Candice",
        "familyName": "Fogarty",
        "jobTitle": "Licensed Paralegal",
        "description": "Licensed Paralegal with the Law Society of Ontario (LSO #P21479) practising at the Landlord and Tenant Board, Small Claims Court, Provincial Offences Court, Human Rights Tribunal of Ontario, and workplace dispute matters where permitted.",
        "image": "https://static.wixstatic.com/media/99571b_c32a188dfc804dd2818850adee4ae3c6~mv2.jpeg",
        "email": "mailto:candice@legalassist.london",
        "telephone": PHONE_TEL,
        "url": "https://www.legalassist.london/about/team#candice-fogarty",
        "worksFor": { "@id": "https://www.legalassist.london/#organization" },
        "memberOf": {
          "@type": "Organization",
          "name": "Law Society of Ontario",
          "url": "https://lso.ca"
        },
        "knowsAbout": [
          "Landlord and Tenant Board (Ontario)",
          "Small Claims Court (Ontario)",
          "Provincial Offences",
          "Human Rights Tribunal of Ontario",
          "Workplace Disputes",
          "Traffic and Driving Offences"
        ],
        "hasCredential": [
          {
            "@type": "EducationalOccupationalCredential",
            "name": "Licensed Paralegal (LSO #P21479)",
            "credentialCategory": "license",
            "recognizedBy": { "@type": "Organization", "name": "Law Society of Ontario" }
          },
          {
            "@type": "EducationalOccupationalCredential",
            "name": "Notary Public (Ontario)",
            "credentialCategory": "license"
          },
          {
            "@type": "EducationalOccupationalCredential",
            "name": "Paralegal Diploma with Distinction",
            "credentialCategory": "degree"
          },
          {
            "@type": "EducationalOccupationalCredential",
            "name": "Commissioner for Taking Affidavits (Ontario)",
            "credentialCategory": "license"
          },
          {
            "@type": "EducationalOccupationalCredential",
            "name": "Qualified Addictions Counselor",
            "credentialCategory": "certification"
          }
        ]
      }
    ]
  };
}

let articleSchema: Record<string, unknown> | null = null;
if (normalizedPath.startsWith('/blog/')) {
  const blogSlug = normalizedPath.slice('/blog/'.length);
  const post = blogPosts.find((p) => p.slug === blogSlug);
  if (post) {
    articleSchema = {
      "@context": "https://schema.org",
      "@type": "LegalArticle",
      "headline": post.title,
      "description": post.description,
      "datePublished": post.date,
      "dateModified": post.date,
      "inLanguage": "en-CA",
      "url": canonicalUrl,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "image": `${businessInfo.url}/og-image.jpg`,
      // Reference the Person graph by @id so Google connects article
      // authorship to the full credentials graph emitted on /about/team
      // (LSO #P22020, hasCredential, worksFor LegalService org, etc.).
      // This is the recommended E-E-A-T pattern for legal content.
      "author": { "@id": "https://www.legalassist.london/about/team#jean-francois-demers" },
      "publisher": { "@id": "https://www.legalassist.london/#organization" },
      "articleSection": post.category,
      "keywords": pageConfig.keywords || ''
    };
  }
}

// Schema.org structured data
const schemaData = {
