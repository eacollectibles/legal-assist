---
/**
 * [...slug].astro - Dynamic page handler with SERVER-SIDE SEO
 * 
 * PERFORMANCE OPTIMIZATIONS:
 * - Critical font preloading
 * - DNS prefetch for external resources
 * - Preconnect for critical origins
 * - Deferred non-critical scripts
 * - Optimized resource hints
 */
import AppRouter from "@/components/Router";
import { seoConfig, businessInfo, generateFAQSchema, generateBreadcrumbSchema } from "@/components/seoConfig";
import { blogPosts } from "@/data/blogData";
import { PHONE_TEL } from "@/lib/contact";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

// Get the current path from Astro
const pathname = Astro.url.pathname;

// Normalize path (remove trailing slash except for root)
const normalizedPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

// Check if this is a private route (noindex)
const isPrivateRoute = /^\/(admin|dashboard|client-dashboard|login|signup|client-login|client-signup|intake|booking|upload|paralegal-dashboard|meeting-request|meeting-dashboard|forgot-password|reset-password|conflict-detected)/.test(normalizedPath);

// Get SEO config for this path, or use defaults
let pageConfig: any = seoConfig[normalizedPath] || {
  title: 'Legal Assist Paralegal Services | London Ontario',
  description: 'Licensed paralegal services in London, Ontario. Traffic tickets, landlord-tenant disputes, small claims court, human rights tribunal. Free consultation. Call 226-272-5153.',
  keywords: 'paralegal london ontario, legal services, traffic ticket lawyer, LTB paralegal, small claims court'
};

// -----------------------------------------------------------------------
// Blog-post SSR SEO override
// -----------------------------------------------------------------------
// For /blog/<slug> URLs, override pageConfig with per-post title /
// description / keywords / breadcrumbs / faqs from blogData. Without
// this, blog posts fall back to homepage defaults until Helmet
// hydrates client-side — meaning crawlers that don't render JS (and
// social-share previewers that snapshot the SSR HTML) see the wrong
// tags.
// -----------------------------------------------------------------------
if (normalizedPath.startsWith('/blog/')) {
  const blogSlug = normalizedPath.slice('/blog/'.length);
  const post = blogPosts.find((p) => p.slug === blogSlug);
  if (post) {
    const categoryLabels: Record<string, string> = {
      'traffic': 'Traffic Tickets',
      'ltb': 'Landlord & Tenant',
      'small-claims': 'Small Claims Court',
      'employment': 'Employment',
      'general': 'Legal Resources'
    };
    const categoryKeywords: Record<string, string> = {
      'traffic': 'traffic ticket ontario, traffic ticket paralegal, ontario traffic ticket defence',
      'ltb': 'landlord tenant ontario, ltb paralegal, residential tenancies act',
      'small-claims': 'small claims court ontario, small claims paralegal, plaintiffs claim',
      'employment': 'employment law ontario, employment standards act, employment paralegal',
      'general': 'ontario paralegal, legal information ontario, licensed paralegal london'
    };
    // SEO-tight title: post headline first, then short brand suffix.
    const ssrTitle = `${post.title} | Legal Assist Blog`;
    pageConfig = {
      title: ssrTitle,
      description: post.description.length > 160
        ? post.description.slice(0, 157).replace(/[\s,]+$/, '') + '...'
        : post.description,
      keywords: categoryKeywords[post.category] || categoryKeywords['general'],
      breadcrumbs: [
        { name: 'Home', url: '/' },
        { name: 'Blog', url: '/blog' },
        { name: categoryLabels[post.category] || 'Article', url: '/blog' },
        { name: post.title, url: `/blog/${post.slug}` }
      ],
      faqs: (post.faqs && post.faqs.length > 0)
        ? post.faqs.map((f) => ({ question: f.q, answer: f.a }))
        : undefined
    };
  }
}

// Build canonical URL
const canonicalUrl = `${businessInfo.url}${normalizedPath === '/' ? '' : normalizedPath}`;

// Derive an H1 from the title (strip brand/city suffixes after separators)
const ssrH1 = pageConfig.title
  .split(/\s*\|\s*/)[0]
  .trim() || 'Legal Assist Paralegal Services';

// Generate JSON-LD for FAQs if present
const faqSchema = pageConfig.faqs && pageConfig.faqs.length > 0
  ? generateFAQSchema(pageConfig.faqs)
  : null;

// Generate JSON-LD for breadcrumbs if present
const breadcrumbSchema = pageConfig.breadcrumbs && pageConfig.breadcrumbs.length > 0
  ? generateBreadcrumbSchema(pageConfig.breadcrumbs, businessInfo.url)
  : null;

// -----------------------------------------------------------------------
// SEO: Article / LegalArticle JSON-LD for blog posts
// -----------------------------------------------------------------------
// Adding per-blog-post Article schema unlocks Article rich snippets in
// Google SERPs (date stamp, author byline, headline). For procedural
// posts ("How to file a plaintiff's claim", "HRTO Form 1 walkthrough"),
// LegalArticle is a more accurate subtype than the generic Article and
// is recognized by Google as Article-equivalent for rich-result eligibility.
//
// We match the URL slug to the blog post in src/data/blogData.ts. If the
// path is /blog/<slug> and a matching post exists, we emit the schema.
// Otherwise this block is null and adds nothing to the head.
//
// The author is the default paralegal (Jean-Francois Demers, LSO #P22020).
// The publisher is the LegalService organization defined in `schemaData`
// above — we reference it by @id rather than duplicating its full graph.
// -----------------------------------------------------------------------
// -----------------------------------------------------------------------
// SEO: Person schema for the firm's licensed paralegals
// -----------------------------------------------------------------------
// Google's E-E-A-T (Experience, Expertise, Authoritativeness,
// Trustworthiness) framework weights legal content heavily on author
// credentials. The /about/team page is where we put names,
// faces, licence numbers, and credentials in front of users — adding a
// Person graph here teaches search engines who the licensed
// professionals behind the legal content actually are, and connects
// them by @id to the LegalService organization above.
//
// Source of truth for paralegal data: src/lib/paralegals.ts (React)
// and letterhead/letterhead.py (Python). Both are checked in.
// -----------------------------------------------------------------------
let teamSchema: Record<string, unknown> | null = null;
if (normalizedPath === '/about/team') {
  teamSchema = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://www.legalassist.london/about/team#jean-francois-demers",
        "name": "Jean-Francois Demers",
        "alternateName": "Johnny Demers",
        "givenName": "Jean-Francois",
        "familyName": "Demers",
        "jobTitle": "Licensed Paralegal",
