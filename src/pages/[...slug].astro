---

<html lang="en" class="w-full h-full">
  <head>
    <!-- Basic charset and viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta httpEquiv="X-UA-Compatible" content="IE=edge" />
    
    <!-- ============================================
         PERFORMANCE: Critical Resource Hints
         ============================================ -->
    
    <!-- Preload critical fonts (eliminates FOIT) -->
    <link 
      rel="preload" 
      href="/fonts/dmsans/v17/rP2Hp2ywxg089UriCZOIHTWEBlw.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin="anonymous"
    />
    <link 
      rel="preload" 
      href="/fonts/playfairdisplay/v40/nuFiD-vYSZviVYUb_rj3ij__anPXDTzYgEM86xQ.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin="anonymous"
    />
    
    <!-- Preconnect for critical third-party origins (upgrades DNS+TCP+TLS in one step) -->
    <link rel="preconnect" href="https://static.wixstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://static.parastorage.com" crossorigin="anonymous" />

    <!-- Preload LCP hero image for instant rendering -->
    <link
      rel="preload"
      as="image"
      type="image/webp"
      imagesrcset="https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_480,h_360,al_c,q_80,enc_avif/banner.webp 480w, https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_768,h_576,al_c,q_80,enc_avif/banner.webp 768w, https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_1024,h_768,al_c,q_80,enc_avif/banner.webp 1024w"
      imagesizes="(max-width: 768px) 100vw, 50vw"
      fetchpriority="high"
    />

    <!-- DNS Prefetch for non-critical external resources -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    
    <!-- SERVER-SIDE SEO: Title -->
    <title>{pageConfig.title}</title>
    
    <!-- SERVER-SIDE SEO: Description -->
    <meta name="description" content={pageConfig.description} />
    
    <!-- SERVER-SIDE SEO: Keywords -->
    {pageConfig.keywords && <meta name="keywords" content={pageConfig.keywords} />}
    
    <!-- SERVER-SIDE SEO: Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- SERVER-SIDE SEO: Robots directive -->
    <meta name="robots" content={isPrivateRoute ? 'noindex, nofollow' : 'index, follow'} />
    
    <!-- Business Meta -->
    <meta name="author" content="Legal Assist Paralegal Services" />
    <meta name="publisher" content="Legal Assist Paralegal Services" />
    <meta name="copyright" content={`© ${currentYear} Legal Assist Paralegal Services`} />
    <meta name="language" content="en-CA" />
    
    <!-- ----------------------------------------------------------
         Per-page Open Graph image with cluster fallback.
         Resolution order:
           1. pageConfig.ogImage           — explicit override on a page
           2. cluster default              — e.g. /og-ltb.jpg for /landlord-tenant-board
           3. /og-image.jpg                — site-wide fallback (always present)
         When you upload new cluster images to /public/ they're picked up
         automatically. og:image:alt is built from the page title so
         social-share previews have meaningful alt text.
         ---------------------------------------------------------- -->
    <meta property="og:type" content={normalizedPath.startsWith('/blog/') ? 'article' : 'website'} />
    <meta property="og:site_name" content="Legal Assist Paralegal Services" />
    <meta property="og:title" content={pageConfig.title} />
    <meta property="og:description" content={pageConfig.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={(() => {
      // Explicit per-page override always wins
      if (pageConfig.ogImage) return `${businessInfo.url}${pageConfig.ogImage}`;
      // Cluster-based defaults — pick by URL prefix. Filenames match
      // the existing assets in /public/. Drop /public/og-home.jpg
      // (1200x630) to give the homepage a dedicated social image.
      if (normalizedPath === '/') return `${businessInfo.url}/og-home.jpg`;
      if (normalizedPath.startsWith('/blog/') || normalizedPath === '/blog') return `${businessInfo.url}/og-blog.jpg`;
      // NB: also accept the canonical `/services/<cluster>` URLs (the
      // app's primary service routes) — previously only the short SEO
      // route variants like `/landlord-tenant-paralegal-london` matched.
      if (normalizedPath.startsWith('/landlord-tenant') || normalizedPath.startsWith('/ltb') || normalizedPath.startsWith('/services/landlord-tenant') || normalizedPath.startsWith('/services/condo') || normalizedPath.startsWith('/services/rental') || normalizedPath.startsWith('/services/eviction')) return `${businessInfo.url}/og-landlord-tenant.jpg`;
      if (normalizedPath.startsWith('/small-claims') || normalizedPath.startsWith('/services/small-claims') || normalizedPath.startsWith('/services/debt') || normalizedPath.startsWith('/services/contract')) return `${businessInfo.url}/og-small-claims.jpg`;
      if (normalizedPath.startsWith('/traffic') || normalizedPath.startsWith('/provincial-offences') || normalizedPath.startsWith('/services/traffic') || normalizedPath.startsWith('/services/provincial-offences') || normalizedPath.startsWith('/services/parking') || normalizedPath.startsWith('/services/dui') || normalizedPath.startsWith('/services/impaired')) return `${businessInfo.url}/og-traffic-tickets.jpg`;
      if (normalizedPath.startsWith('/human-rights') || normalizedPath.startsWith('/hrto') || normalizedPath.startsWith('/services/human-rights') || normalizedPath.startsWith('/services/discrimination')) return `${businessInfo.url}/og-human-rights.jpg`;
      if (normalizedPath.startsWith('/employment') || normalizedPath.startsWith('/services/employment') || normalizedPath.startsWith('/services/wsib') || normalizedPath.startsWith('/services/workplace') || normalizedPath.startsWith('/services/wrongful')) return `${businessInfo.url}/og-employment.jpg`;
      if (normalizedPath.startsWith('/criminal') || normalizedPath.startsWith('/services/criminal') || normalizedPath.startsWith('/services/assault') || normalizedPath.startsWith('/services/theft')) return `${businessInfo.url}/og-criminal.jpg`;
      // Fallback for everything else (locations, guides, about, contact, etc.)
      return `${businessInfo.url}/og-image.jpg`;
    })()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${pageConfig.title.split(/\s*\|\s*/)[0]} — Legal Assist Paralegal Services, London Ontario`} />

    <!-- SERVER-SIDE SEO: Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageConfig.title} />
    <meta name="twitter:description" content={pageConfig.description} />
    <meta name="twitter:image" content={(() => {
      // Mirrors the og:image resolution above so Twitter/X previews use
      // the same per-cluster artwork.
      if (pageConfig.ogImage) return `${businessInfo.url}${pageConfig.ogImage}`;
      if (normalizedPath === '/') return `${businessInfo.url}/og-home.jpg`;
      if (normalizedPath.startsWith('/blog/') || normalizedPath === '/blog') return `${businessInfo.url}/og-blog.jpg`;
      // NB: also accept the canonical `/services/<cluster>` URLs (the
      // app's primary service routes) — previously only the short SEO
      // route variants like `/landlord-tenant-paralegal-london` matched.
      if (normalizedPath.startsWith('/landlord-tenant') || normalizedPath.startsWith('/ltb') || normalizedPath.startsWith('/services/landlord-tenant') || normalizedPath.startsWith('/services/condo') || normalizedPath.startsWith('/services/rental') || normalizedPath.startsWith('/services/eviction')) return `${businessInfo.url}/og-landlord-tenant.jpg`;
      if (normalizedPath.startsWith('/small-claims') || normalizedPath.startsWith('/services/small-claims') || normalizedPath.startsWith('/services/debt') || normalizedPath.startsWith('/services/contract')) return `${businessInfo.url}/og-small-claims.jpg`;
      if (normalizedPath.startsWith('/traffic') || normalizedPath.startsWith('/provincial-offences') || normalizedPath.startsWith('/services/traffic') || normalizedPath.startsWith('/services/provincial-offences') || normalizedPath.startsWith('/services/parking') || normalizedPath.startsWith('/services/dui') || normalizedPath.startsWith('/services/impaired')) return `${businessInfo.url}/og-traffic-tickets.jpg`;
      if (normalizedPath.startsWith('/human-rights') || normalizedPath.startsWith('/hrto') || normalizedPath.startsWith('/services/human-rights') || normalizedPath.startsWith('/services/discrimination')) return `${businessInfo.url}/og-human-rights.jpg`;
      if (normalizedPath.startsWith('/employment') || normalizedPath.startsWith('/services/employment') || normalizedPath.startsWith('/services/wsib') || normalizedPath.startsWith('/services/workplace') || normalizedPath.startsWith('/services/wrongful')) return `${businessInfo.url}/og-employment.jpg`;
      if (normalizedPath.startsWith('/criminal') || normalizedPath.startsWith('/services/criminal') || normalizedPath.startsWith('/services/assault') || normalizedPath.startsWith('/services/theft')) return `${businessInfo.url}/og-criminal.jpg`;
      return `${businessInfo.url}/og-image.jpg`;
    })()} />
    
    <!-- SERVER-SIDE SEO: Geo tags -->
    <meta name="geo.region" content="CA-ON" />
    <meta name="geo.placename" content="London, Ontario" />
    <meta name="geo.position" content="42.9849;-81.2453" />
    <meta name="ICBM" content="42.9849, -81.2453" />
    
    <!-- Theme and PWA -->
    <meta name="theme-color" content="#B94A1F" />
    <meta name="msapplication-TileColor" content="#B94A1F" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Legal Assist" />
    <meta name="application-name" content="Legal Assist" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Favicon and Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Security -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    
    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    
    <!-- SERVER-SIDE SEO: FAQ Schema if present -->
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    
    <!-- SERVER-SIDE SEO: Breadcrumb Schema if present -->
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <!-- SERVER-SIDE SEO: LegalArticle Schema for blog posts -->
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <!-- SERVER-SIDE SEO: Person Schema (E-E-A-T) on /about/team -->
    {teamSchema && <script type="application/ld+json" set:html={JSON.stringify(teamSchema)} />}
    
    <!-- ============================================
         PERFORMANCE: Critical CSS (Inline)
         Prevents render-blocking for above-the-fold content
         ============================================ -->
    <style is:inline>
      /* Critical CSS - Above the fold styles */
      html{opacity:0;visibility:hidden;background-color:#F9F5F0}
      html.hydrated{opacity:1;visibility:visible;transition:opacity .15s ease-in-out}
      body{margin:0;font-family:'DM Sans',system-ui,-apple-system,sans-serif;background-color:#F9F5F0;color:#4A2C23}
      .bg-background{background-color:#F9F5F0}
      .text-secondary{color:#4A2C23}
      .text-primary{color:#B94A1F}
      .font-heading{font-family:'Playfair Display',Georgia,serif}
      .font-paragraph{font-family:'DM Sans',system-ui,sans-serif}
      /* Loading skeleton */
      .skeleton-pulse{animation:pulse 1.5s cubic-bezier(.4,0,.6,1) infinite}
      @keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
      /* Prevent layout shift */
      #root{min-height:100vh;display:flex;flex-direction:column}
      /* SSR SEO content: keep in DOM for crawlers, visually offscreen; auto-removed when React hydrates */
      #ssr-seo-content{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}
    </style>
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full bg-background">
      <!-- SSR Hero Placeholder: Paints LCP image before React hydrates, then React replaces #root contents -->
      <div id="ssr-hero-placeholder" style="position:relative;width:100%;min-height:60vh;overflow:hidden;background:#F9F5F0;">
        <picture>
          <source
            type="image/webp"
            srcset="https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_480,h_360,al_c,q_80,enc_avif/banner.webp 480w, https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_768,h_576,al_c,q_80,enc_avif/banner.webp 768w, https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_1024,h_768,al_c,q_80,enc_avif/banner.webp 1024w"
            sizes="(max-width: 768px) 100vw, 50vw"
          />
          <img
            src="https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_768,h_576,al_c,q_80/banner.jpeg"
            srcset="https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_480,h_360,al_c,q_75/banner.jpeg 480w, https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_768,h_576,al_c,q_80/banner.jpeg 768w, https://static.wixstatic.com/media/99571b_8e05531429e9472d888eec555c78c9f4~mv2.jpeg/v1/fill/w_1024,h_768,al_c,q_80/banner.jpeg 1024w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="Paralegal consultation in London Ontario"
            width="768"
            height="576"
            fetchpriority="high"
            decoding="async"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
          />
        </picture>
      </div>
      <!--
        SSR SEO Content: rendered server-side for crawlers.
        React (client:only) replaces #root contents on hydration so users never see this.
        Without this block, every page served the same empty shell to Googlebot, causing
        Soft 404 / Crawled-not-indexed / Discovered-not-indexed issues across the site.
      -->
      <div id="ssr-seo-content" aria-hidden="true">
        <h1>{ssrH1}</h1>
        <p>{pageConfig.description}</p>
        {pageConfig.breadcrumbs && pageConfig.breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumb">
            <ol>
              {pageConfig.breadcrumbs.map((bc) => (
                <li><a href={bc.url}>{bc.name}</a></li>
              ))}
            </ol>
          </nav>
        )}
        {pageConfig.faqs && pageConfig.faqs.length > 0 && (
          <section>
            <h2>Frequently Asked Questions</h2>
            {pageConfig.faqs.map((faq) => (
              <div>
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))}
          </section>
        )}
        <section>
          <h2>Contact Legal Assist</h2>
          <p>
            Legal Assist Paralegal Services &mdash; Licensed by the Law Society of Ontario.
            Serving London, Ontario and Southwestern Ontario. Call
            <a href={`tel:${PHONE_TEL}`}>{businessInfo.telephoneDisplay}</a>
            or email <a href={`mailto:${businessInfo.email}`}>{businessInfo.email}</a>
            for a free consultation.
          </p>
        </section>
      </div>
      <AppRouter client:only="react" />
    </div>
    
    <script>
      // CRITICAL: Fast hydration marker - reveals page content
      const markHydrated = () => {
        document.documentElement.classList.add('hydrated');
      };
      
      // Mark immediately
      if (document.readyState === 'complete') {
        markHydrated();
      } else {
        // Use fastest available event
        if (document.readyState === 'interactive') {
          markHydrated();
        } else {
          document.addEventListener('DOMContentLoaded', markHydrated, { once: true });
        }
      }
      
      // Fallback timeouts
      setTimeout(markHydrated, 100);
      setTimeout(markHydrated, 1000);

      // Remove SSR hero placeholder and SSR SEO content once React renders (fade to avoid CLS)
      const observer = new MutationObserver(() => {
        const placeholder = document.getElementById('ssr-hero-placeholder');
        const seoContent = document.getElementById('ssr-seo-content');
        const root = document.getElementById('root');
        // Wait until React has rendered its own content (more than just our SSR placeholders)
        const reactReady = root && root.children.length > (placeholder ? 1 : 0) + (seoContent ? 1 : 0);
        if (reactReady) {
          if (placeholder) {
            placeholder.style.transition = 'opacity 0.2s ease-out';
            placeholder.style.opacity = '0';
            placeholder.style.position = 'absolute';
            placeholder.style.pointerEvents = 'none';
            setTimeout(() => placeholder.remove(), 250);
          }
          // SSR SEO content is already offscreen; just remove it to keep DOM lean.
          if (seoContent) {
            seoContent.remove();
          }
          observer.disconnect();
        }
      });
      observer.observe(document.getElementById('root'), { childList: true, subtree: true });
      
      // Emergency fallback
      setTimeout(() => {
        if (!document.documentElement.classList.contains('hydrated')) {
          console.warn('[Hydration] Emergency fallback triggered');
          markHydrated();
        }
      }, 3000);
    </script>
    
    <!-- Prefetch likely navigation targets -->
    <link rel="prefetch" href="/services" />
    <link rel="prefetch" href="/contact" />
  </body>
</html>
